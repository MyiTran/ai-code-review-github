.d-flex.flex-column.flex-lg-row.align-items-lg-center.justify-content-between.gap-3.mb-4
  div
    h1.page-title Settings

    p.page-description
      | Manage your profile, AI review preferences and integrations.

  span.settings-save-state.text-secondary.small
    i.bi.bi-cloud-check.me-2
    | Frontend preview mode

.row.g-4
  .col-12.col-xl-3
    .dashboard-card.settings-navigation-card
      nav.settings-navigation
        a.settings-navigation-item.active href="#profile"
          span.settings-navigation-icon
            i.bi.bi-person

          span
            strong Profile
            small Personal information

        a.settings-navigation-item href="#ai-review"
          span.settings-navigation-icon
            i.bi.bi-stars

          span
            strong AI review
            small Review configuration

        a.settings-navigation-item href="#notifications"
          span.settings-navigation-icon
            i.bi.bi-bell

          span
            strong Notifications
            small Email and GitHub alerts

        a.settings-navigation-item href="#github"
          span.settings-navigation-icon
            i.bi.bi-github

          span
            strong GitHub integration
            small Connected account

        a.settings-navigation-item href="#billing"
          span.settings-navigation-icon
            i.bi.bi-credit-card

          span
            strong Plan and usage
            small Current subscription

  .col-12.col-xl-9
    section#profile.dashboard-card.settings-section.mb-4
      .settings-section-header
        .d-flex.align-items-center.gap-3
          span.settings-section-icon
            i.bi.bi-person

          div
            h2.card-title-custom Profile

            p.mb-0.mt-1.text-secondary.small
              | Update your personal account information.

      .settings-section-body
        .d-flex.flex-column.flex-md-row.align-items-md-center.gap-4.mb-4
          span.settings-avatar
            = @settings[:profile][:initials]

          div
            h3.settings-profile-name
              = @settings[:profile][:name]

            p.mb-2.text-secondary
              | @#{@settings[:profile][:github_username]}

            button.btn.btn-light.btn-sm type="button"
              i.bi.bi-upload.me-2
              | Change avatar

        .row.g-4
          .col-12.col-md-6
            label.form-label.fw-semibold for="settings-name"
              | Full name

            input#settings-name.form-control type="text" value=@settings[:profile][:name]

          .col-12.col-md-6
            label.form-label.fw-semibold for="settings-email"
              | Email address

            input#settings-email.form-control type="email" value=@settings[:profile][:email]

          .col-12.col-md-6
            label.form-label.fw-semibold for="settings-github-username"
              | GitHub username

            input#settings-github-username.form-control type="text" value=@settings[:profile][:github_username] disabled=true

            p.form-helper-text
              | Managed by your connected GitHub account.

        .settings-actions
          button.btn.btn-primary.settings-save-button type="button"
            i.bi.bi-check-lg.me-2
            | Save profile

    section#ai-review.dashboard-card.settings-section.mb-4
      .settings-section-header
        .d-flex.align-items-center.gap-3
          span.settings-section-icon.settings-section-icon-purple
            i.bi.bi-stars

          div
            h2.card-title-custom AI review preferences

            p.mb-0.mt-1.text-secondary.small
              | Configure the default behavior for newly connected repositories.

      .settings-section-body
        .settings-option
          .settings-option-copy
            label.settings-option-title for="default-auto-review"
              | Enable automatic AI review

            p.settings-option-description
              | Automatically analyze new and updated pull requests.

          .form-check.form-switch.mb-0
            input#default-auto-review.form-check-input.ai-review-toggle type="checkbox" role="switch" checked=@settings[:review][:auto_review_enabled]

        .settings-option
          .settings-option-copy
            label.settings-option-title for="review-on-push"
              | Review after new commits

            p.settings-option-description
              | Run another review when commits are pushed to an open pull request.

          .form-check.form-switch.mb-0
            input#review-on-push.form-check-input.ai-review-toggle type="checkbox" role="switch" checked=@settings[:review][:review_on_push]

        .settings-option
          .settings-option-copy
            label.settings-option-title for="review-drafts"
              | Review draft pull requests

            p.settings-option-description
              | Include pull requests marked as drafts.

          .form-check.form-switch.mb-0
            input#review-drafts.form-check-input.ai-review-toggle type="checkbox" role="switch" checked=@settings[:review][:review_drafts]

        .settings-option
          .settings-option-copy
            label.settings-option-title for="include-suggestions"
              | Include improvement suggestions

            p.settings-option-description
              | Show non-blocking suggestions for maintainability and code style.

          .form-check.form-switch.mb-0
            input#include-suggestions.form-check-input.ai-review-toggle type="checkbox" role="switch" checked=@settings[:review][:include_suggestions]

        .row.g-4.mt-1
          .col-12.col-md-6
            label.form-label.fw-semibold for="default-ai-model"
              | Default AI model

            select#default-ai-model.form-select
              option selected=(@settings[:review][:default_model] == "Gemini 2.5 Flash")
                | Gemini 2.5 Flash

              option selected=(@settings[:review][:default_model] == "Claude Sonnet")
                | Claude Sonnet

              option selected=(@settings[:review][:default_model] == "GPT-4.1 Mini")
                | GPT-4.1 Mini

            p.form-helper-text
              | Repositories can override this setting individually.

          .col-12.col-md-6
            label.form-label.fw-semibold for="severity-threshold"
              | Minimum finding level

            select#severity-threshold.form-select
              option selected=(@settings[:review][:severity_threshold] == "Suggestion")
                | Suggestion

              option selected=(@settings[:review][:severity_threshold] == "Warning")
                | Warning

              option selected=(@settings[:review][:severity_threshold] == "Critical")
                | Critical only

            p.form-helper-text
              | Findings below this level will not be displayed.

          .col-12.col-md-6
            label.form-label.fw-semibold for="maximum-files"
              | Maximum files per review

            input#maximum-files.form-control type="number" min="1" max="100" value=@settings[:review][:maximum_files]

            p.form-helper-text
              | Pull requests above this limit may be partially analyzed.

        .settings-actions
          button.btn.btn-primary.settings-save-button type="button"
            i.bi.bi-check-lg.me-2
            | Save review preferences

    section#notifications.dashboard-card.settings-section.mb-4
      .settings-section-header
        .d-flex.align-items-center.gap-3
          span.settings-section-icon.settings-section-icon-warning
            i.bi.bi-bell

          div
            h2.card-title-custom Notifications

            p.mb-0.mt-1.text-secondary.small
              | Choose when and where you receive review updates.

      .settings-section-body
        .settings-option
          .settings-option-copy
            label.settings-option-title for="notify-completed"
              | Completed reviews

            p.settings-option-description
              | Send an email when an AI review is completed.

          .form-check.form-switch.mb-0
            input#notify-completed.form-check-input.ai-review-toggle type="checkbox" role="switch" checked=@settings[:notifications][:email_completed_reviews]

        .settings-option
          .settings-option-copy
            label.settings-option-title for="notify-failed"
              | Failed reviews

            p.settings-option-description
              | Notify you when a review fails and requires attention.

          .form-check.form-switch.mb-0
            input#notify-failed.form-check-input.ai-review-toggle type="checkbox" role="switch" checked=@settings[:notifications][:email_failed_reviews]

        .settings-option
          .settings-option-copy
            label.settings-option-title for="notify-weekly"
              | Weekly summary

            p.settings-option-description
              | Receive a weekly summary of repositories, reviews and findings.

          .form-check.form-switch.mb-0
            input#notify-weekly.form-check-input.ai-review-toggle type="checkbox" role="switch" checked=@settings[:notifications][:email_weekly_summary]

        .settings-option
          .settings-option-copy
            label.settings-option-title for="github-comments"
              | Post review results on GitHub

            p.settings-option-description
              | Add AI findings as a comment on the associated pull request.

          .form-check.form-switch.mb-0
            input#github-comments.form-check-input.ai-review-toggle type="checkbox" role="switch" checked=@settings[:notifications][:github_comments]

        .settings-actions
          button.btn.btn-primary.settings-save-button type="button"
            i.bi.bi-check-lg.me-2
            | Save notifications

    section#github.dashboard-card.settings-section.mb-4
      .settings-section-header
        .d-flex.align-items-center.gap-3
          span.settings-section-icon.settings-section-icon-dark
            i.bi.bi-github

          div
            h2.card-title-custom GitHub integration

            p.mb-0.mt-1.text-secondary.small
              | Manage the GitHub account connected to AI Code Review.

      .settings-section-body
        .integration-card
          .d-flex.flex-column.flex-md-row.align-items-md-center.justify-content-between.gap-4
            .d-flex.align-items-center.gap-3
              span.integration-logo
                i.bi.bi-github

              div
                .d-flex.flex-wrap.align-items-center.gap-2.mb-1
                  h3.integration-title.mb-0
                    | @#{@settings[:github][:account]}

                  span.badge.badge-soft-success.rounded-pill.px-3.py-2
                    i.bi.bi-check-circle.me-1
                    = @settings[:github][:installation_status]

                p.mb-1.text-secondary.small
                  | #{@settings[:github][:repositories_count]} repositories connected

                p.mb-0.text-secondary.small
                  | Connected on #{@settings[:github][:connected_at]}

            .d-flex.flex-wrap.gap-2
              button.btn.btn-light type="button"
                i.bi.bi-arrow-repeat.me-2
                | Reconnect

              button.btn.btn-outline-danger type="button"
                i.bi.bi-link-45deg.me-2
                | Disconnect

    section#billing.dashboard-card.settings-section
      .settings-section-header
        .d-flex.align-items-center.gap-3
          span.settings-section-icon.settings-section-icon-success
            i.bi.bi-credit-card

          div
            h2.card-title-custom Plan and usage

            p.mb-0.mt-1.text-secondary.small
              | Review your current plan and monthly AI usage.

      .settings-section-body
        .plan-card
          .d-flex.flex-column.flex-md-row.align-items-md-start.justify-content-between.gap-4.mb-4
            div
              span.plan-label Current plan

              .d-flex.align-items-center.gap-3.mt-2
                h3.plan-name.mb-0
                  = @settings[:billing][:plan]

                span.badge.bg-light.text-primary.rounded-pill.px-3.py-2
                  | Active

              p.mb-0.mt-2.text-secondary.small
                | Renews on #{@settings[:billing][:renewal_date]}

            button.btn.btn-primary type="button"
              i.bi.bi-arrow-up-circle.me-2
              | Upgrade plan

          .usage-header
            span.fw-semibold Monthly AI reviews

            span.text-secondary.small
              | #{@settings[:billing][:reviews_used]} of #{@settings[:billing][:reviews_limit]} used

          - usage_percentage = (@settings[:billing][:reviews_used].to_f / @settings[:billing][:reviews_limit] * 100).round

          .progress.settings-usage-progress
            .progress-bar role="progressbar" style="width: #{usage_percentage}%" aria-valuenow=usage_percentage aria-valuemin="0" aria-valuemax="100"

          p.form-helper-text.mb-0
            | Usage resets on #{@settings[:billing][:renewal_date]}.