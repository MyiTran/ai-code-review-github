.mb-4
  = link_to reviews_path, class: "text-decoration-none text-secondary small" do
    i.bi.bi-arrow-left.me-2
    | Back to AI reviews

.d-flex.flex-column.flex-xl-row.align-items-xl-start.justify-content-between.gap-4.mb-4
  .d-flex.align-items-start.gap-3
    span.review-detail-icon
      i.bi.bi-code-square

    div
      .d-flex.flex-wrap.align-items-center.gap-2.mb-2
        h1.page-title.mb-0
          | ##{@review[:pull_request_number]} #{@review[:title]}

        - if @review[:status] == "Completed"
          span.badge.badge-soft-success.rounded-pill.px-3.py-2
            i.bi.bi-check-circle.me-1
            | Completed
        - else
          span.badge.badge-soft-warning.rounded-pill.px-3.py-2
            i.bi.bi-arrow-repeat.me-1
            | Processing

      p.page-description.mb-3
        = @review[:description]

      .d-flex.flex-wrap.align-items-center.gap-3.text-secondary.small
        = link_to repository_path(@review[:repository_id]), class: "text-decoration-none text-secondary" do
          i.bi.bi-github.me-1
          = @review[:repository_full_name]

        span
          i.bi.bi-git.me-1
          = @review[:source_branch]

        i.bi.bi-arrow-right

        span
          = @review[:target_branch]

        span
          i.bi.bi-person.me-1
          = @review[:author]

  .d-flex.flex-wrap.gap-2
    a.btn.btn-light href=@review[:github_url] target="_blank" rel="noopener"
      i.bi.bi-box-arrow-up-right.me-2
      | View pull request

    button.btn.btn-primary type="button"
      i.bi.bi-arrow-repeat.me-2
      | Run review again

.row.g-4.mb-4
  .col-12.col-sm-6.col-xl-3
    .dashboard-card.p-4
      .stat-icon.stat-icon-danger.mb-4
        i.bi.bi-bug

      .stat-value.mb-2
        = @review[:issues_found]

      .stat-label
        | Findings

  .col-12.col-sm-6.col-xl-3
    .dashboard-card.p-4
      .stat-icon.stat-icon-primary.mb-4
        i.bi.bi-file-earmark-code

      .stat-value.mb-2
        = @review[:files_changed]

      .stat-label
        | Files Changed

  .col-12.col-sm-6.col-xl-3
    .dashboard-card.p-4
      .stat-icon.stat-icon-success.mb-4
        i.bi.bi-plus-lg

      .stat-value.mb-2.text-success
        | +#{@review[:additions]}

      .stat-label
        | Additions

  .col-12.col-sm-6.col-xl-3
    .dashboard-card.p-4
      .stat-icon.stat-icon-warning.mb-4
        i.bi.bi-dash-lg

      .stat-value.mb-2.text-danger
        | -#{@review[:deletions]}

      .stat-label
        | Deletions

.row.g-4
  .col-12.col-xl-8
    .dashboard-card.mb-4
      .p-4.border-bottom
        .d-flex.align-items-center.gap-3
          span.ai-summary-icon
            i.bi.bi-stars

          div
            h2.card-title-custom AI review summary

            p.mb-0.mt-1.text-secondary.small
              | Generated by #{@review[:model]}

      .p-4
        p.ai-summary-text.mb-0
          = @review[:summary]

    .dashboard-card.mb-4
      .d-flex.flex-column.flex-md-row.align-items-md-center.justify-content-between.gap-3.p-4.border-bottom
        div
          h2.card-title-custom Findings

          p.mb-0.mt-1.text-secondary.small
            | Issues and suggestions detected during the review.

        .d-flex.flex-wrap.gap-2
          - if @review[:critical_count].positive?
            span.badge.severity-critical
              | #{@review[:critical_count]} critical

          - if @review[:warning_count].positive?
            span.badge.severity-warning
              | #{@review[:warning_count]} warnings

          - if @review[:suggestion_count].positive?
            span.badge.severity-suggestion
              | #{@review[:suggestion_count]} suggestions

      - if @review[:findings].any?
        .review-findings
          - @review[:findings].each do |finding|
            .review-finding-item
              .d-flex.flex-column.flex-md-row.align-items-md-start.justify-content-between.gap-3.mb-3
                .d-flex.align-items-start.gap-3
                  - if finding[:severity] == "Critical"
                    span.finding-severity-icon.finding-severity-critical
                      i.bi.bi-exclamation-octagon
                  - elsif finding[:severity] == "Warning"
                    span.finding-severity-icon.finding-severity-warning
                      i.bi.bi-exclamation-triangle
                  - else
                    span.finding-severity-icon.finding-severity-suggestion
                      i.bi.bi-lightbulb

                  div
                    .d-flex.flex-wrap.align-items-center.gap-2.mb-1
                      h3.finding-title.mb-0
                        = finding[:title]

                      span.finding-category
                        = finding[:category]

                    p.mb-0.text-secondary.small
                      i.bi.bi-file-earmark-code.me-1
                      = finding[:file_path]

                      - if finding[:line_number].present?
                        | :#{finding[:line_number]}

                - if finding[:severity] == "Critical"
                  span.badge.severity-critical Critical
                - elsif finding[:severity] == "Warning"
                  span.badge.severity-warning Warning
                - else
                  span.badge.severity-suggestion Suggestion

              p.finding-description
                = finding[:description]

              - if finding[:code].present?
                pre.finding-code
                  code
                    = finding[:code]

              .finding-suggestion
                .d-flex.align-items-start.gap-2
                  i.bi.bi-lightbulb.text-warning

                  div
                    p.mb-1.fw-semibold Suggested improvement

                    p.mb-0.text-secondary
                      = finding[:suggestion]

      - else
        .text-center.p-5
          span.empty-state-icon.empty-state-success.mb-3
            i.bi.bi-check-lg

          h3.fs-5 No issues found

          p.text-secondary.mb-0
            | The AI review did not detect any significant issues in this pull request.

    .dashboard-card
      .p-4.border-bottom
        h2.card-title-custom Changed files

        p.mb-0.mt-1.text-secondary.small
          | Files analyzed as part of this pull request.

      - if @review[:changed_files].any?
        .list-group.list-group-flush
          - @review[:changed_files].each do |file|
            .list-group-item.p-4
              .d-flex.flex-column.flex-md-row.align-items-md-center.justify-content-between.gap-3
                .d-flex.align-items-center.gap-3
                  span.changed-file-icon
                    i.bi.bi-file-earmark-code

                  div
                    p.mb-1.fw-semibold
                      = file[:path]

                    - if file[:findings_count].positive?
                      p.mb-0.text-danger.small
                        i.bi.bi-exclamation-triangle.me-1
                        | #{file[:findings_count]} findings
                    - else
                      p.mb-0.text-success.small
                        i.bi.bi-check-circle.me-1
                        | No findings

                .d-flex.align-items-center.gap-3.small
                  span.text-success
                    | +#{file[:additions]}

                  span.text-danger
                    | -#{file[:deletions]}
      - else
        .p-5.text-center.text-secondary
          | File analysis is still in progress.

  .col-12.col-xl-4
    .dashboard-card.p-4.mb-4
      h2.card-title-custom.mb-4 Review information

      .repository-info-row
        span.text-secondary Repository

        = link_to @review[:repository_name],
            repository_path(@review[:repository_id]),
            class: "fw-semibold text-decoration-none"

      .repository-info-row
        span.text-secondary Pull request

        span.fw-semibold
          | ##{@review[:pull_request_number]}

      .repository-info-row
        span.text-secondary Author

        span.fw-semibold
          = @review[:author]

      .repository-info-row
        span.text-secondary Commit

        code
          = @review[:commit_sha]

      .repository-info-row
        span.text-secondary AI model

        span.ai-model-badge
          i.bi.bi-stars
          = @review[:model]

      .repository-info-row
        span.text-secondary Duration

        span.fw-semibold
          = @review[:duration]

      .repository-info-row
        span.text-secondary Reviewed

        span.fw-semibold
          = @review[:reviewed_at]

      .repository-info-row.border-0.pb-0
        span.text-secondary Conclusion

        span.fw-semibold
          = @review[:conclusion]

    .dashboard-card.p-4
      h2.card-title-custom.mb-4 Finding breakdown

      .review-breakdown-row
        .d-flex.align-items-center.gap-2
          span.breakdown-dot.breakdown-critical
          span Critical

        strong
          = @review[:critical_count]

      .review-breakdown-row
        .d-flex.align-items-center.gap-2
          span.breakdown-dot.breakdown-warning
          span Warning

        strong
          = @review[:warning_count]

      .review-breakdown-row.border-0.pb-0
        .d-flex.align-items-center.gap-2
          span.breakdown-dot.breakdown-suggestion
          span Suggestion

        strong
          = @review[:suggestion_count]